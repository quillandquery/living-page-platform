# Supabase — from your project's API settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used by scripts/seed.mjs to seed a story past RLS. Never ship
# to the browser and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The site's own origin, used in auth email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (optional). Leave both unset and every analytics call in
# lib/analytics/* becomes a silent no-op — local dev and CI need nothing
# here. Get a project key from posthog.com (free tier), or self-host.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
