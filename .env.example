# Supabase — from your project's API settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Used by scripts/seed.mjs to seed a story past RLS. Never ship
# to the browser and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The site's own origin, used in auth email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (optional). Leave both unset and every analytics call in
# lib/analytics/* becomes a silent no-op — local dev and CI need nothing
# here. Get a project key from posthog.com (free tier), or self-host.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics (optional). Leave unset and the gtag.js tags in
# app/layout.tsx / app/providers.tsx never render — local dev and CI need
# nothing here. Get a Measurement ID (starts with "G-") from
# analytics.google.com → Admin → Data Streams → your web stream.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only, optional — a deliberate, narrow exception to D1 ("heuristic,
# no LLM"). Leave unset and the writing-intelligence pass stays 100%
# heuristic/local. Gates every opt-in, writer-clicked AI touchpoint in that
# pass — nothing here ever runs on its own:
#   - lib/ai/nudge-fallback.ts   — the in-flow nudge's "look closer" offer
#   - lib/ai/suggest-line.ts     — "suggest a line" (in-flow nudge + the
#                                  tightening pass's notions/phrasing/imagery)
#   - lib/ai/suggest-reorder.ts  — the tightening pass's "check the order"
#   - lib/ai/suggest-proofread.ts — the tightening pass's "check spelling
#                                  & grammar"
# Leave unset and every one of these quietly no-ops (or, for proofread,
# reports "couldn't check right now" rather than a false "nothing found").
# Get a key from console.anthropic.com. Never ship to the browser.
ANTHROPIC_API_KEY=
