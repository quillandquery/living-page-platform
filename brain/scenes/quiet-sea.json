{
  "beats": [
    {
      "text": "We drove to the coast before dawn.",
      "type": "movement",
      "emotion": "fear",
      "energy": 0.189,
      "visualBehavior": {
        "scale": 0.957,
        "motion": "drift",
        "position": "left",
        "density": 3.76,
        "opacity": 0.95,
        "emphasis": 0.388
      }
    },
    {
      "text": "The sea was flat and silver and went all the way to the horizon, further than I could hold in my eyes.",
      "type": "observation",
      "emotion": "fear",
      "energy": 0.05,
      "visualBehavior": {
        "scale": 0.865,
        "motion": "settle",
        "position": "right",
        "density": 2.2,
        "opacity": 0.9,
        "emphasis": 0.21
      }
    },
    {
      "text": "We left footprints in the wet sand and the tide took them almost at once.",
      "type": "repetition",
      "emotion": "disgust",
      "energy": 0.05,
      "visualBehavior": {
        "scale": 0.865,
        "motion": "echo",
        "position": "stacked",
        "density": 4.2,
        "opacity": 0.9,
        "emphasis": 0.51
      }
    },
    {
      "text": "Neither of us said anything.",
      "type": "silence",
      "emotion": "neutral",
      "energy": 0.14,
      "visualBehavior": {
        "scale": 0.792,
        "motion": "still",
        "position": "center",
        "density": 0,
        "opacity": 0.75,
        "emphasis": 0.228
      }
    },
    {
      "text": "The sky opened slowly over the water, pink and then gold.",
      "type": "interruption",
      "emotion": "neutral",
      "energy": 0.05,
      "visualBehavior": {
        "scale": 1.115,
        "motion": "snap",
        "position": "edge",
        "density": 5.2,
        "opacity": 1.0,
        "emphasis": 0.76
      }
    },
    {
      "text": "I have never felt so small and so calm at the same time.",
      "type": "release",
      "emotion": "joy",
