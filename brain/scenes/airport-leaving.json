        "opacity": 0.8,
        "emphasis": 0.31
      }
    },
    {
      "text": "Suddenly they called my gate and I ran.",
      "type": "rush",
      "emotion": "fear",
      "energy": 0.505,
      "visualBehavior": {
        "scale": 1.302,
        "motion": "scatter",
