        "density": 9.02,
        "opacity": 0.95,
        "emphasis": 0.901
      }
    },
    {
      "text": "I ran through the whole terminal, my bag slamming against my hip, and I made it just as the doors were closing.",
      "type": "rush",
      "emotion": "surprise",
      "energy": 0.153,
      "visualBehavior": {
        "scale": 1.196,
