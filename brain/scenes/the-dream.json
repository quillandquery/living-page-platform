{
  "beats": [
    {
      "text": "In the dream the staircase went up into nothing and I kept climbing anyway.",
      "type": "waiting",
      "emotion": "fear",
      "energy": 0.05,
      "visualBehavior": {
        "scale": 0.815,
        "motion": "hold",
        "position": "center",
        "density": 0.2,
        "opacity": 0.8,
        "emphasis": 0.21
      }
    },
    {
      "text": "The walls were made of water and I could see my own face in them, doubled, tripled, wrong.",
      "type": "observation",
      "emotion": "disgust",
      "energy": 0.05,
      "visualBehavior": {
        "scale": 0.865,
        "motion": "settle",
        "position": "right",
        "density": 2.2,
        "opacity": 0.95,
        "emphasis": 0.21
      }
    },
    {
      "text": "A clock on the wall was melting, slow as honey.",
      "type": "observation",
      "emotion": "surprise",
      "energy": 0.05,
      "visualBehavior": {
        "scale": 0.865,
        "motion": "settle",
        "position": "left",
        "density": 2.2,
        "opacity": 0.95,
        "emphasis": 0.21
      }
    },
    {
      "text": "Somewhere a cassette tape had come unspooled and its ribbon floated in the air like a brown river.",
      "type": "reflection",
      "emotion": "disgust",
      "energy": 0.05,
      "visualBehavior": {
        "scale": 0.865,
        "motion": "driftslow",
        "position": "narrow",
        "density": 0.2,
        "opacity": 0.8,
        "emphasis": 0.31
      }
    },
    {
      "text": "I was weightless.",
      "type": "interruption",
      "emotion": "fear",
      "energy": 0.14,
      "visualBehavior": {
        "scale": 1.142,
        "motion": "snap",
        "position": "edge",
        "density": 5.56,
        "opacity": 0.95,
        "emphasis": 0.778
      }
    },
    {
      "text": "I reached for the red thread that hung from the ceiling and when I touched it everything shattered into bright pieces and I woke up.",
      "type": "arrival",
      "emotion": "surprise",
      "energy": 0.05,
      "visualBehavior": {
        "scale": 1.165,
        "motion": "enter",
        "position": "center",
        "density": 3.2,
        "opacity": 1.0,
        "emphasis": 0.71
      }
    }
