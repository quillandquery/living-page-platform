{
  "beats": [
    {
      "text": "My grandmother's kitchen always smelled of cardamom and something burning slightly at the edges.",
      "type": "observation",
      "emotion": "disgust",
      "energy": 0.05,
      "visualBehavior": {
        "scale": 0.865,
        "motion": "settle",
        "position": "left",
        "density": 2.2,
        "opacity": 0.95,
        "emphasis": 0.21
      }
    },
    {
      "text": "I used to sit at the table while she worked, my feet not reaching the floor.",
      "type": "repetition",
      "emotion": "disgust",
      "energy": 0.05,
      "visualBehavior": {
        "scale": 0.865,
        "motion": "echo",
        "position": "stacked",
        "density": 4.2,
        "opacity": 0.9,
        "emphasis": 0.51
      }
    },
    {
      "text": "The afternoon light came through the window in long yellow bars, and dust turned slowly in it.",
      "type": "repetition",
      "emotion": "disgust",
      "energy": 0.05,
      "visualBehavior": {
        "scale": 0.865,
        "motion": "echo",
        "position": "stacked",
        "density": 4.2,
        "opacity": 0.9,
        "emphasis": 0.51
      }
    },
    {
      "text": "She never spoke much.",
      "type": "interruption",
      "emotion": "neutral",
      "energy": 0.14,
      "visualBehavior": {
        "scale": 1.142,
        "motion": "snap",
        "position": "edge",
        "density": 5.56,
        "opacity": 1.0,
        "emphasis": 0.778
      }
    },
    {
      "text": "She would press a warm cup of tea into my hands and I would hold it, not drinking, just letting the heat move into my fingers.",
      "type": "anticipation",
      "emotion": "disgust",
      "energy": 0.05,
      "visualBehavior": {
        "scale": 0.915,
        "motion": "rise",
        "position": "center",
        "density": 1.2,
        "opacity": 0.9,
        "emphasis": 0.46
      }
    },
    {
      "text": "There was an old photograph on the shelf, faded almost to nothing, of a woman I never met.",
      "type": "discovery",
      "emotion": "disgust",
      "energy": 0.05,
      "visualBehavior": {
        "scale": 1.065,
        "motion": "reveal",
        "position": "center",
        "density": 3.2,
        "opacity": 1.0,
        "emphasis": 0.61
      }
    },
    {
      "text": "Years later I still think of that room.",
      "type": "reflection",
      "emotion": "neutral",
      "energy": 0.05,
      "visualBehavior": {
        "scale": 0.865,
        "motion": "driftslow",
        "position": "narrow",
        "density": 0.2,
        "opacity": 0.8,
        "emphasis": 0.31
      }
    },
    {
      "text": "I think of her hands.",
      "type": "reflection",
      "emotion": "disgust",
      "energy": 0.14,
      "visualBehavior": {
        "scale": 0.892,
        "motion": "driftslow",
        "position": "narrow",
        "density": 0.56,
        "opacity": 0.8,
        "emphasis": 0.328
      }
    },
    {
      "text": "I think of the quiet.",
      "type": "silence",
      "emotion": "neutral",
      "energy": 0.14,
      "visualBehavior": {
        "scale": 0.792,
        "motion": "still",
        "position": "center",
        "density": 0,
        "opacity": 0.75,
        "emphasis": 0.228
      }
    }
  ],
